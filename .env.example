# Copie ce fichier en `.env` (jamais commité) et remplis les valeurs.

# --- Général ---
NODE_ENV=development
TZ=Africa/Tunis
# Dossier des données (SQLite, cache fichiers, sauvegardes). En Docker : /data (fixé par compose).
DATA_DIR=./data
# Adresse publique de l'app (en prod : https://<nom-du-serveur>.<tailnet>.ts.net)
APP_URL=http://localhost:3000

# --- Mode démo ---
# 1 = fausses données réalistes, sans mot de passe ni source externe (`pnpm demo` le fait pour toi).
# Ne jamais l'activer sur une instance qui contient de vraies données.
TANDHIM_DEMO=0
# 1 = aperçu d'écran à une date donnée : /?a=2026-11-24T10:00 (développement seulement).
TANDHIM_APERCU=0

# --- Sécurité de l'app ---
# Hachage scrypt du mot de passe unique de l'app : `pnpm mot-de-passe`.
APP_PASSWORD_HASH=
# Secret des sessions : 32 caractères minimum (ex. `openssl rand -base64 48`).
SESSION_SECRET=
# Clé de chiffrement des tokens OAuth stockés (ex. `openssl rand -base64 32`).
ENCRYPTION_KEY=

# --- Google (Gmail, Classroom, Drive) : OAuth 2.0, lecture seule ---
# Identifiants d'un client OAuth « application Web » (Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini (Google AI Studio, niveau gratuit) ---
GEMINI_API_KEY=
# Les noms de modèles changent souvent : à ajuster si `pnpm check:gemini` répond 404.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Lecture des documents joints (tableaux, plannings) : plus fiable, 20 requêtes/jour seulement.
GEMINI_DOCS_MODEL=gemini-3.8-flash
# Quotas gratuits (AI Studio, 20/11/2026) : 3.5 et 3.1 Flash Lite = 15 req/min, 500 req/jour ; 3.8 Flash = 5 req/min, 20 req/jour.
GEMINI_RPM=15
GEMINI_RPD=500

# --- Notifications (Web Push) ---
# Paire de clés VAPID : `pnpm cles-notifications` (une seule fois ; changer les clés désabonne les appareils).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Messenger (serveur Matrix privé + pont mautrix-meta, installés à part sur le serveur) ---
# Joignable depuis le worker par le réseau Docker de l'app.
MATRIX_URL=
# Jeton d'accès du compte Matrix de lecture (créé sur le serveur, jamais commité).
MATRIX_TOKEN=
# Salons à lire (identifiants « !… », séparés par des virgules).
MATRIX_SALONS=

# --- IA ---
# Nom de la déléguée de la classe, cité dans le prompt (ses annonces relaient les profs). Facultatif.
TANDHIM_DELEGUEE=
